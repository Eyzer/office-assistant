# 统一按 LF 入库，避免 Windows 上提交的脚本在 Linux 上因 CRLF 报错
* text=auto eol=lf

*.sh    text eol=lf
*.py    text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.ini   text eol=lf
*.conf  text eol=lf
*.service text eol=lf

# .bat 是 GBK 编码 + CRLF，必须当二进制处理，否则 git 转换会把中文弄乱
*.bat   binary

*.png   binary
*.jpg   binary
*.gz    binary
*.deb   binary
