# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
*.deb

# 运行时产物（本地生成，不入库）
logs/*.log
uploads/*
output/*
config.ini
profiles/*.json

# 离线依赖：wheel 体积 80MB+，只随 Release 分发，不进 git
offline-deps/wheels/*
!offline-deps/wheels/.gitkeep
vendor/*
!vendor/.gitkeep
!vendor/README.txt

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db
